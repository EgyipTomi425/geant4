Bootstrap: localimage
From: .build/eic_xl-nightly.sif

%files
    scripts/run_simulations.py /opt/geant-generator/run_simulations.py
    scripts/better_root_to_csv.py /opt/geant-generator/better_root_to_csv.py
    scripts/root_to_csv_with_particles.py /opt/geant-generator/root_to_csv_with_particles.py
    scripts/container_runscript.sh /opt/geant-generator/container_runscript.sh

%post
    mkdir -p /opt/geant-generator
    chmod 0555 /opt/geant-generator/run_simulations.py
    chmod 0555 /opt/geant-generator/better_root_to_csv.py
    chmod 0555 /opt/geant-generator/root_to_csv_with_particles.py
    chmod 0555 /opt/geant-generator/container_runscript.sh

%environment
    export PYTHONUNBUFFERED=1

%runscript
    exec /bin/bash /opt/geant-generator/container_runscript.sh "$@"

%help
    Self-contained EIC Geant generator runner.
    Usage: apptainer run geant-generator.sif [config.json | --config config.json] [runner options]
    Without a config argument, ./config.json in the current directory is used.
